# Copy this file to .env and fill in the values for your machine.
# python-decouple reads this automatically - see docverify/settings.py.

# --- Django core ---------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Blockchain (Ganache by default) --------------------------------------
# Ganache GUI default RPC URL. If you use `ganache` CLI instead, match
# whatever port you launched it with.
WEB3_PROVIDER_URI=http://127.0.0.1:7545

# Filled in after you run `python scripts/deploy_contract.py` with Ganache
# running - copy the printed "Contract address" here.
CONTRACT_ADDRESS=

# Private key of the account that deployed the contract (or any account the
# contract owner has authorized via authorizeIssuer()). Copy it from
# Ganache's "Accounts" tab (click the key icon) or CLI startup output.
# NEVER use a real-money mainnet key here - this is for local/test chains.
DEPLOYER_PRIVATE_KEY=

# Must match the chain Ganache reports (Ganache's default is 1337; some
# older versions use 5777 - check the Ganache UI/CLI output).
CHAIN_ID=1337

# --- OCR -------------------------------------------------------------------
# Path to the Tesseract executable. Leave blank on Linux/macOS if
# `tesseract` is already on your PATH. On Windows, set it explicitly, e.g.:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
